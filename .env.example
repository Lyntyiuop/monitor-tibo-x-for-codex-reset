# Copy this file to .env for local testing.

# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-sender@gmail.com
EMAIL_TO=your-recipient@gmail.com

# Optional. Comma-separated cc recipients.
EMAIL_CC=

# Optional LLM classification. Leave disabled to use keyword-only matching.
USE_LLM_CLASSIFIER=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Monitor settings
CONFIG_PATH=config.yaml
STATE_PATH=data/state.json
DRY_RUN=false
